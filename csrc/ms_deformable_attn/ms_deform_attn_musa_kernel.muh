#ifndef DEFORM_ATTN_MUSA_KERNEL
#define DEFORM_ATTN_MUSA_KERNEL

#include "musa_kernel_helper.muh"

#if defined(__MUSA_ARCH__) && __MUSA_ARCH__ == 310  // MUSIFY_EXCL_LINE
#define __SYNCTHREADS_LM __syncthreads_lm()
#else
#define __SYNCTHREADS_LM __syncthreads()
#endif

template <typename scalar_t>
__device__ __forceinline__ scalar_t ms_deform_attn_warp_reduce_sum(scalar_t val) {
  for (int offset = 16; offset > 0; offset >>= 1) val += __shfl_down_sync(0xffffffff, val, offset);
  return val;
}

template <typename T>
__device__ __forceinline__ T ms_deform_attn_warp_broadcast(T val, int src_lane = 0) {
  return __shfl_sync(0xffffffff, val, src_lane);
}

template <>
__device__ __forceinline__ phalf ms_deform_attn_warp_reduce_sum(phalf val) {
  for (int offset = 16; offset > 0; offset >>= 1) __PHALF(val) += __shfl_down_sync(0xffffffff, __PHALF(val), offset);
  return val;
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__device__ acc_t ms_deform_attn_im2col_bilinear(const scalar_t *&bottom_data,
                                                const int       &height,
                                                const int       &width,
                                                const int       &nheads,
                                                const int       &channels,
                                                const acc_t     &h,
                                                const acc_t     &w,
                                                const int       &m,
                                                const int       &c) {
  const int h_low  = floorf(h);
  const int w_low  = floorf(w);
  const int h_high = h_low + 1;
  const int w_high = w_low + 1;

  const acc_t lh = h - h_low;
  const acc_t lw = w - w_low;
  const acc_t hh = 1 - lh, hw = 1 - lw;

  const int w_stride          = nheads * channels;
  const int h_stride          = width * w_stride;
  const int h_low_ptr_offset  = h_low * h_stride;
  const int h_high_ptr_offset = h_low_ptr_offset + h_stride;
  const int w_low_ptr_offset  = w_low * w_stride;
  const int w_high_ptr_offset = w_low_ptr_offset + w_stride;
  const int base_ptr          = m * channels + c;

  acc_t v1 = 0;
  if (h_low >= 0 && w_low >= 0) {
    const int ptr1 = h_low_ptr_offset + w_low_ptr_offset + base_ptr;
    v1             = static_cast<acc_t>(bottom_data[ptr1]);
  }
  acc_t v2 = 0;
  if (h_low >= 0 && w_high <= width - 1) {
    const int ptr2 = h_low_ptr_offset + w_high_ptr_offset + base_ptr;
    v2             = static_cast<acc_t>(bottom_data[ptr2]);
  }
  acc_t v3 = 0;
  if (h_high <= height - 1 && w_low >= 0) {
    const int ptr3 = h_high_ptr_offset + w_low_ptr_offset + base_ptr;
    v3             = static_cast<acc_t>(bottom_data[ptr3]);
  }
  acc_t v4 = 0;
  if (h_high <= height - 1 && w_high <= width - 1) {
    const int ptr4 = h_high_ptr_offset + w_high_ptr_offset + base_ptr;
    v4             = static_cast<acc_t>(bottom_data[ptr4]);
  }

  const acc_t w1 = hh * hw, w2 = hh * lw, w3 = lh * hw, w4 = lh * lw;

  const acc_t val = (w1 * v1 + w2 * v2 + w3 * v3 + w4 * v4);
  return val;
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__device__ void ms_deform_attn_col2im_bilinear(const scalar_t *&bottom_data,
                                               const int       &height,
                                               const int       &width,
                                               const int       &nheads,
                                               const int       &channels,
                                               const acc_t     &h,
                                               const acc_t     &w,
                                               const int       &m,
                                               const int       &c,
                                               const acc_t     &top_grad,
                                               const acc_t     &attn_weight,
                                               acc_t          *&grad_value,
                                               acc_t           *grad_sampling_loc,
                                               acc_t           *grad_attn_weight) {
  const int h_low  = floorf(h);
  const int w_low  = floorf(w);
  const int h_high = h_low + 1;
  const int w_high = w_low + 1;

  const acc_t lh = h - h_low;
  const acc_t lw = w - w_low;
  const acc_t hh = 1 - lh, hw = 1 - lw;

  const int w_stride          = nheads * channels;
  const int h_stride          = width * w_stride;
  const int h_low_ptr_offset  = h_low * h_stride;
  const int h_high_ptr_offset = h_low_ptr_offset + h_stride;
  const int w_low_ptr_offset  = w_low * w_stride;
  const int w_high_ptr_offset = w_low_ptr_offset + w_stride;
  const int base_ptr          = m * channels + c;

  const acc_t w1 = hh * hw, w2 = hh * lw, w3 = lh * hw, w4 = lh * lw;
  const acc_t top_grad_value = top_grad * attn_weight;
  acc_t       grad_h_weight = 0, grad_w_weight = 0;

  acc_t v1 = 0;
  if (h_low >= 0 && w_low >= 0) {
    const int ptr1 = h_low_ptr_offset + w_low_ptr_offset + base_ptr;
    v1             = static_cast<acc_t>(bottom_data[ptr1]);
    grad_h_weight -= hw * v1;
    grad_w_weight -= hh * v1;
    atomicAdd(grad_value + ptr1, w1 * top_grad_value);
  }
  acc_t v2 = 0;
  if (h_low >= 0 && w_high <= width - 1) {
    const int ptr2 = h_low_ptr_offset + w_high_ptr_offset + base_ptr;
    v2             = static_cast<acc_t>(bottom_data[ptr2]);
    grad_h_weight -= lw * v2;
    grad_w_weight += hh * v2;
    atomicAdd(grad_value + ptr2, w2 * top_grad_value);
  }
  acc_t v3 = 0;
  if (h_high <= height - 1 && w_low >= 0) {
    const int ptr3 = h_high_ptr_offset + w_low_ptr_offset + base_ptr;
    v3             = static_cast<acc_t>(bottom_data[ptr3]);
    grad_h_weight += hw * v3;
    grad_w_weight -= lh * v3;
    atomicAdd(grad_value + ptr3, w3 * top_grad_value);
  }
  acc_t v4 = 0;
  if (h_high <= height - 1 && w_high <= width - 1) {
    const int ptr4 = h_high_ptr_offset + w_high_ptr_offset + base_ptr;
    v4             = static_cast<acc_t>(bottom_data[ptr4]);
    grad_h_weight += lw * v4;
    grad_w_weight += lh * v4;
    atomicAdd(grad_value + ptr4, w4 * top_grad_value);
  }

  const acc_t val          = (w1 * v1 + w2 * v2 + w3 * v3 + w4 * v4);
  *grad_attn_weight        = top_grad * val;
  *grad_sampling_loc       = width * grad_w_weight * top_grad_value;
  *(grad_sampling_loc + 1) = height * grad_h_weight * top_grad_value;
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__device__ void ms_deform_attn_col2im_bilinear_gm(const scalar_t *&bottom_data,
                                                  const int       &height,
                                                  const int       &width,
                                                  const int       &nheads,
                                                  const int       &channels,
                                                  const acc_t     &h,
                                                  const acc_t     &w,
                                                  const int       &m,
                                                  const int       &c,
                                                  const acc_t     &top_grad,
                                                  const acc_t     &attn_weight,
                                                  acc_t          *&grad_value,
                                                  acc_t           *grad_sampling_loc,
                                                  acc_t           *grad_attn_weight) {
  const int h_low  = floorf(h);
  const int w_low  = floorf(w);
  const int h_high = h_low + 1;
  const int w_high = w_low + 1;

  const acc_t lh = h - h_low;
  const acc_t lw = w - w_low;
  const acc_t hh = 1 - lh, hw = 1 - lw;

  const int w_stride          = nheads * channels;
  const int h_stride          = width * w_stride;
  const int h_low_ptr_offset  = h_low * h_stride;
  const int h_high_ptr_offset = h_low_ptr_offset + h_stride;
  const int w_low_ptr_offset  = w_low * w_stride;
  const int w_high_ptr_offset = w_low_ptr_offset + w_stride;
  const int base_ptr          = m * channels + c;

  const acc_t w1 = hh * hw, w2 = hh * lw, w3 = lh * hw, w4 = lh * lw;
  const acc_t top_grad_value = top_grad * attn_weight;
  acc_t       grad_h_weight = 0, grad_w_weight = 0;

  acc_t v1 = 0;
  if (h_low >= 0 && w_low >= 0) {
    const int ptr1 = h_low_ptr_offset + w_low_ptr_offset + base_ptr;
    v1             = static_cast<acc_t>(bottom_data[ptr1]);
    grad_h_weight -= hw * v1;
    grad_w_weight -= hh * v1;
    atomicAdd(grad_value + ptr1, w1 * top_grad_value);
  }
  acc_t v2 = 0;
  if (h_low >= 0 && w_high <= width - 1) {
    const int ptr2 = h_low_ptr_offset + w_high_ptr_offset + base_ptr;
    v2             = static_cast<acc_t>(bottom_data[ptr2]);
    grad_h_weight -= lw * v2;
    grad_w_weight += hh * v2;
    atomicAdd(grad_value + ptr2, w2 * top_grad_value);
  }
  acc_t v3 = 0;
  if (h_high <= height - 1 && w_low >= 0) {
    const int ptr3 = h_high_ptr_offset + w_low_ptr_offset + base_ptr;
    v3             = static_cast<acc_t>(bottom_data[ptr3]);
    grad_h_weight += hw * v3;
    grad_w_weight -= lh * v3;
    atomicAdd(grad_value + ptr3, w3 * top_grad_value);
  }
  acc_t v4 = 0;
  if (h_high <= height - 1 && w_high <= width - 1) {
    const int ptr4 = h_high_ptr_offset + w_high_ptr_offset + base_ptr;
    v4             = static_cast<acc_t>(bottom_data[ptr4]);
    grad_h_weight += lw * v4;
    grad_w_weight += lh * v4;
    atomicAdd(grad_value + ptr4, w4 * top_grad_value);
  }

  const acc_t val = (w1 * v1 + w2 * v2 + w3 * v3 + w4 * v4);
  atomicAdd(grad_attn_weight, top_grad * val);
  atomicAdd(grad_sampling_loc, width * grad_w_weight * top_grad_value);
  atomicAdd(grad_sampling_loc + 1, height * grad_h_weight * top_grad_value);
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_im2col_gpu_kernel(const int       n,
                                                const scalar_t *data_value,
                                                const int64_t  *data_spatial_shapes,
                                                const int64_t  *data_level_start_index,
                                                const scalar_t *data_sampling_loc,
                                                const scalar_t *data_attn_weight,
                                                const int       batch_size,
                                                const int       spatial_size,
                                                const int       num_heads,
                                                const int       channels,
                                                const int       num_levels,
                                                const int       num_query,
                                                const int       num_point,
                                                scalar_t       *data_col) {
  MUSA_1D_KERNEL_LOOP(index, n) {
    int       _temp = index;
    const int c_col = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    scalar_t *data_col_ptr               = data_col + index;
    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;
    acc_t     col                        = 0;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id = data_level_start_index[l_col];
      const int       spatial_h_ptr  = l_col << 1;
      const int       spatial_h      = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w      = data_spatial_shapes[spatial_h_ptr + 1];
      const scalar_t *data_value_ptr = data_value + (data_value_ptr_init_offset + level_start_id * qid_stride);
      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im = loc_w * spatial_w - acc_t(0.5);

        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          col += ms_deform_attn_im2col_bilinear(
                     data_value_ptr, spatial_h, spatial_w, num_heads, channels, h_im, w_im, m_col, c_col) *
                 weight;
        }

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
      }
    }
    *data_col_ptr = static_cast<scalar_t>(col);
  }
}

template <typename scalar_t, int numLevels, int numPoint, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_im2col_gpu_kernel_channels32(const int       n,
                                                           const scalar_t *data_value,
                                                           const int64_t  *data_spatial_shapes,
                                                           const int64_t  *data_level_start_index,
                                                           const scalar_t *data_sampling_loc,
                                                           const scalar_t *data_attn_weight,
                                                           const int       batch_size,
                                                           const int       spatial_size,
                                                           const int       num_heads,
                                                           const int       num_query,
                                                           scalar_t       *data_col) {
  constexpr int channels = 32;
  MUSA_1D_KERNEL_LOOP(index, n) {
    const int c_col          = index & (channels - 1);
    int       _temp          = index >> 5;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    int       data_weight_ptr            = sampling_index * numLevels * numPoint;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;
    acc_t     col                        = 0;

#pragma unroll
    for (int l_col = 0; l_col < numLevels; ++l_col) {
      const int       level_start_id = data_level_start_index[l_col];
      const int       spatial_h_ptr  = l_col << 1;
      const int       spatial_h      = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w      = data_spatial_shapes[spatial_h_ptr + 1];
      const scalar_t *data_value_ptr = data_value + (data_value_ptr_init_offset + level_start_id * qid_stride);
#pragma unroll
      for (int p_col = 0; p_col < numPoint; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im = loc_w * spatial_w - acc_t(0.5);

        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          col += ms_deform_attn_im2col_bilinear(
                     data_value_ptr, spatial_h, spatial_w, num_heads, channels, h_im, w_im, m_col, c_col) *
                 weight;
        }

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
      }
    }
    data_col[index] = static_cast<scalar_t>(col);
  }
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_im2col_gpu_kernel_channels32_runtime(const int       n,
                                                                   const scalar_t *data_value,
                                                                   const int64_t  *data_spatial_shapes,
                                                                   const int64_t  *data_level_start_index,
                                                                   const scalar_t *data_sampling_loc,
                                                                   const scalar_t *data_attn_weight,
                                                                   const int       batch_size,
                                                                   const int       spatial_size,
                                                                   const int       num_heads,
                                                                   const int       num_levels,
                                                                   const int       num_query,
                                                                   const int       num_point,
                                                                   scalar_t       *data_col) {
  constexpr int channels = 32;
  MUSA_1D_KERNEL_LOOP(index, n) {
    const int c_col          = index & (channels - 1);
    int       _temp          = index >> 5;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;
    acc_t     col                        = 0;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id = data_level_start_index[l_col];
      const int       spatial_h_ptr  = l_col << 1;
      const int       spatial_h      = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w      = data_spatial_shapes[spatial_h_ptr + 1];
      const scalar_t *data_value_ptr = data_value + (data_value_ptr_init_offset + level_start_id * qid_stride);
      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im = loc_w * spatial_w - acc_t(0.5);

        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          col += ms_deform_attn_im2col_bilinear(
                     data_value_ptr, spatial_h, spatial_w, num_heads, channels, h_im, w_im, m_col, c_col) *
                 weight;
        }

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
      }
    }
    data_col[index] = static_cast<scalar_t>(col);
  }
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_im2col_scatter_div_gpu_kernel_channels32_runtime(const int       n,
                                                                               const scalar_t *data_value,
                                                                               const int64_t  *data_spatial_shapes,
                                                                               const int64_t  *data_level_start_index,
                                                                               const scalar_t *data_sampling_loc,
                                                                               const scalar_t *data_attn_weight,
                                                                               const int64_t  *data_index,
                                                                               const scalar_t *data_count,
                                                                               const int       batch_size,
                                                                               const int       num_cams,
                                                                               const int       cam_id,
                                                                               const int       spatial_size,
                                                                               const int       num_heads,
                                                                               const int       num_levels,
                                                                               const int       valid_len,
                                                                               const int       max_len,
                                                                               const int       num_point,
                                                                               const int       num_query,
                                                                               scalar_t       *data_slots) {
  constexpr int channels = 32;
  MUSA_1D_KERNEL_LOOP(index, n) {
    const int c_col = index & (channels - 1);
    int       _temp = index >> 5;
    const int m_col = _temp % num_heads;
    _temp /= num_heads;
    const int q_col = _temp % valid_len;
    const int b_col = _temp / valid_len;

    const int64_t bev_query                  = data_index[q_col];
    const int     sample_id                  = b_col * num_cams + cam_id;
    const int     sampling_index             = (sample_id * max_len + q_col) * num_heads + m_col;
    int           data_weight_ptr            = sampling_index * num_levels * num_point;
    int           data_loc_w_ptr             = data_weight_ptr << 1;
    const int     qid_stride                 = num_heads * channels;
    const int     data_value_ptr_init_offset = sample_id * spatial_size * qid_stride;
    acc_t         col                        = 0;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id = data_level_start_index[l_col];
      const int       spatial_h_ptr  = l_col << 1;
      const int       spatial_h      = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w      = data_spatial_shapes[spatial_h_ptr + 1];
      const scalar_t *data_value_ptr = data_value + (data_value_ptr_init_offset + level_start_id * qid_stride);
      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im = loc_w * spatial_w - acc_t(0.5);

        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          col += ms_deform_attn_im2col_bilinear(
                     data_value_ptr, spatial_h, spatial_w, num_heads, channels, h_im, w_im, m_col, c_col) *
                 weight;
        }

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
      }
    }

    const acc_t inv_count   = acc_t(1) / data_count[b_col * num_query + bev_query];
    const int   slot_offset = (b_col * num_query + bev_query) * qid_stride + m_col * channels + c_col;
    data_slots[slot_offset] += col * inv_count;
  }
}

template <typename scalar_t, unsigned int blockSize, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_shm_blocksize_aware_reduce_v1(const int       n,
                                                                              const scalar_t *grad_col,
                                                                              const scalar_t *data_value,
                                                                              const int64_t  *data_spatial_shapes,
                                                                              const int64_t  *data_level_start_index,
                                                                              const scalar_t *data_sampling_loc,
                                                                              const scalar_t *data_attn_weight,
                                                                              const int       batch_size,
                                                                              const int       spatial_size,
                                                                              const int       num_heads,
                                                                              const int       channels,
                                                                              const int       num_levels,
                                                                              const int       num_query,
                                                                              const int       num_point,
                                                                              acc_t          *grad_value,
                                                                              acc_t          *grad_sampling_loc,
                                                                              acc_t          *grad_attn_weight) {
  const int qid_stride = num_heads * channels;
  MUSA_1D_KERNEL_LOOP(index, n) {
    __shared__ acc_t cache_grad_sampling_loc[blockSize * 2];
    __shared__ acc_t cache_grad_attn_weight[blockSize];
    unsigned int     tid   = threadIdx.x;
    int              _temp = index;
    const int        c_col = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    const acc_t top_grad = static_cast<acc_t>(grad_col[index]);

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int grad_sampling_ptr          = data_weight_ptr;
    acc_t    *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t    *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const int grad_weight_stride         = 1;
    const int grad_loc_stride            = 2;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id   = data_level_start_index[l_col];
      const int       spatial_h_ptr    = l_col << 1;
      const int       spatial_h        = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w        = data_spatial_shapes[spatial_h_ptr + 1];
      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im = loc_w * spatial_w - acc_t(0.5);
        if constexpr (blockSize == 32) {
          acc_t grad_sampling_loc_cache[2] = {acc_t(0), acc_t(0)};
          acc_t grad_attn_weight_cache     = acc_t(0);
          if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
            ms_deform_attn_col2im_bilinear(data_value_ptr,
                                           spatial_h,
                                           spatial_w,
                                           num_heads,
                                           channels,
                                           h_im,
                                           w_im,
                                           m_col,
                                           c_col,
                                           top_grad,
                                           weight,
                                           grad_value_ptr,
                                           grad_sampling_loc_cache,
                                           &grad_attn_weight_cache);
          }

          const acc_t grad_w = ms_deform_attn_warp_reduce_sum(grad_sampling_loc_cache[0]);
          const acc_t grad_h = ms_deform_attn_warp_reduce_sum(grad_sampling_loc_cache[1]);
          const acc_t grad_a = ms_deform_attn_warp_reduce_sum(grad_attn_weight_cache);

          if (tid == 0) {
            *grad_sampling_loc_out       = grad_w;
            *(grad_sampling_loc_out + 1) = grad_h;
            *grad_attn_weight_out        = grad_a;
          }
        } else {
          *(cache_grad_sampling_loc + (threadIdx.x << 1))       = 0;
          *(cache_grad_sampling_loc + ((threadIdx.x << 1) + 1)) = 0;
          *(cache_grad_attn_weight + threadIdx.x)               = 0;
          if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
            ms_deform_attn_col2im_bilinear(data_value_ptr,
                                           spatial_h,
                                           spatial_w,
                                           num_heads,
                                           channels,
                                           h_im,
                                           w_im,
                                           m_col,
                                           c_col,
                                           top_grad,
                                           weight,
                                           grad_value_ptr,
                                           cache_grad_sampling_loc + (threadIdx.x << 1),
                                           cache_grad_attn_weight + threadIdx.x);
          }

          __SYNCTHREADS_LM;
          if (tid == 0) {
            acc_t _grad_w = cache_grad_sampling_loc[0], _grad_h = cache_grad_sampling_loc[1],
                  _grad_a = cache_grad_attn_weight[0];
            int sid       = 2;
            for (unsigned int tid = 1; tid < blockSize; ++tid) {
              _grad_w += cache_grad_sampling_loc[sid];
              _grad_h += cache_grad_sampling_loc[sid + 1];
              _grad_a += cache_grad_attn_weight[tid];
              sid += 2;
            }

            *grad_sampling_loc_out       = _grad_w;
            *(grad_sampling_loc_out + 1) = _grad_h;
            *grad_attn_weight_out        = _grad_a;
          }
          __SYNCTHREADS_LM;
        }

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += grad_weight_stride;
        grad_sampling_loc_out += grad_loc_stride;
      }
    }
  }
}

template <typename scalar_t, unsigned int kWarpsPerBlock, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_warp_broadcast_multi_warp_channels32(
    const int       n,
    const scalar_t *grad_col,
    const scalar_t *data_value,
    const int64_t  *data_spatial_shapes,
    const int64_t  *data_level_start_index,
    const scalar_t *data_sampling_loc,
    const scalar_t *data_attn_weight,
    const int       batch_size,
    const int       spatial_size,
    const int       num_heads,
    const int       channels,
    const int       num_levels,
    const int       num_query,
    const int       num_point,
    acc_t          *grad_value,
    acc_t          *grad_sampling_loc,
    acc_t          *grad_attn_weight) {
  constexpr unsigned int kWarpSize        = 32;
  const unsigned int     lane_id          = threadIdx.x & (kWarpSize - 1);
  const unsigned int     warp_id          = threadIdx.x >> 5;
  const int              qid_stride       = num_heads * channels;
  const int              num_warp_kernels = n >> 5;

  for (int warp_kernel = blockIdx.x * kWarpsPerBlock + warp_id; warp_kernel < num_warp_kernels;
       warp_kernel += gridDim.x * kWarpsPerBlock) {
    const int   c_col                      = lane_id;
    const int   sampling_index             = warp_kernel;
    const int   m_col                      = sampling_index % num_heads;
    const int   b_col                      = sampling_index / (num_heads * num_query);
    const int   grad_sampling_ptr          = sampling_index * num_levels * num_point;
    acc_t      *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t      *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const acc_t top_grad                   = static_cast<acc_t>(grad_col[(warp_kernel << 5) + lane_id]);
    const int   data_value_ptr_init_offset = b_col * spatial_size * qid_stride;
    int         data_weight_ptr            = grad_sampling_ptr;
    int         data_loc_w_ptr             = grad_sampling_ptr << 1;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      int level_start_id = 0;
      int spatial_h      = 0;
      int spatial_w      = 0;
      if (lane_id == 0) {
        level_start_id          = static_cast<int>(data_level_start_index[l_col]);
        const int spatial_h_ptr = l_col << 1;
        spatial_h               = static_cast<int>(data_spatial_shapes[spatial_h_ptr]);
        spatial_w               = static_cast<int>(data_spatial_shapes[spatial_h_ptr + 1]);
      }
      level_start_id = ms_deform_attn_warp_broadcast(level_start_id);
      spatial_h      = ms_deform_attn_warp_broadcast(spatial_h);
      spatial_w      = ms_deform_attn_warp_broadcast(spatial_w);

      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        acc_t loc_w  = acc_t(0);
        acc_t loc_h  = acc_t(0);
        acc_t weight = acc_t(0);
        if (lane_id == 0) {
          loc_w  = data_sampling_loc[data_loc_w_ptr];
          loc_h  = data_sampling_loc[data_loc_w_ptr + 1];
          weight = data_attn_weight[data_weight_ptr];
        }
        loc_w  = ms_deform_attn_warp_broadcast(loc_w);
        loc_h  = ms_deform_attn_warp_broadcast(loc_h);
        weight = ms_deform_attn_warp_broadcast(weight);

        const acc_t h_im                       = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im                       = loc_w * spatial_w - acc_t(0.5);
        acc_t       grad_sampling_loc_cache[2] = {acc_t(0), acc_t(0)};
        acc_t       grad_attn_weight_cache     = acc_t(0);
        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          ms_deform_attn_col2im_bilinear(data_value_ptr,
                                         spatial_h,
                                         spatial_w,
                                         num_heads,
                                         channels,
                                         h_im,
                                         w_im,
                                         m_col,
                                         c_col,
                                         top_grad,
                                         weight,
                                         grad_value_ptr,
                                         grad_sampling_loc_cache,
                                         &grad_attn_weight_cache);
        }

        const acc_t grad_w = ms_deform_attn_warp_reduce_sum(grad_sampling_loc_cache[0]);
        const acc_t grad_h = ms_deform_attn_warp_reduce_sum(grad_sampling_loc_cache[1]);
        const acc_t grad_a = ms_deform_attn_warp_reduce_sum(grad_attn_weight_cache);

        if (lane_id == 0) {
          *grad_sampling_loc_out       = grad_w;
          *(grad_sampling_loc_out + 1) = grad_h;
          *grad_attn_weight_out        = grad_a;
        }

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += 1;
        grad_sampling_loc_out += 2;
      }
    }
  }
}

template <typename scalar_t, unsigned int blockSize, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_shm_blocksize_aware_reduce_v2(const int       n,
                                                                              const scalar_t *grad_col,
                                                                              const scalar_t *data_value,
                                                                              const int64_t  *data_spatial_shapes,
                                                                              const int64_t  *data_level_start_index,
                                                                              const scalar_t *data_sampling_loc,
                                                                              const scalar_t *data_attn_weight,
                                                                              const int       batch_size,
                                                                              const int       spatial_size,
                                                                              const int       num_heads,
                                                                              const int       channels,
                                                                              const int       num_levels,
                                                                              const int       num_query,
                                                                              const int       num_point,
                                                                              acc_t          *grad_value,
                                                                              acc_t          *grad_sampling_loc,
                                                                              acc_t          *grad_attn_weight) {
  MUSA_1D_KERNEL_LOOP(index, n) {
    __shared__ acc_t cache_grad_sampling_loc[blockSize * 2];
    __shared__ acc_t cache_grad_attn_weight[blockSize];
    unsigned int     tid   = threadIdx.x;
    int              _temp = index;
    const int        c_col = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    const acc_t top_grad = static_cast<acc_t>(grad_col[index]);

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int grad_sampling_ptr          = data_weight_ptr;
    acc_t    *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t    *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const int grad_weight_stride         = 1;
    const int grad_loc_stride            = 2;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id   = data_level_start_index[l_col];
      const int       spatial_h_ptr    = l_col << 1;
      const int       spatial_h        = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w        = data_spatial_shapes[spatial_h_ptr + 1];
      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im                                      = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im                                      = loc_w * spatial_w - acc_t(0.5);
        *(cache_grad_sampling_loc + (threadIdx.x << 1))       = 0;
        *(cache_grad_sampling_loc + ((threadIdx.x << 1) + 1)) = 0;
        *(cache_grad_attn_weight + threadIdx.x)               = 0;
        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          ms_deform_attn_col2im_bilinear(data_value_ptr,
                                         spatial_h,
                                         spatial_w,
                                         num_heads,
                                         channels,
                                         h_im,
                                         w_im,
                                         m_col,
                                         c_col,
                                         top_grad,
                                         weight,
                                         grad_value_ptr,
                                         cache_grad_sampling_loc + (threadIdx.x << 1),
                                         cache_grad_attn_weight + threadIdx.x);
        }

        __SYNCTHREADS_LM;

        for (unsigned int s = blockSize / 2; s > 0; s >>= 1) {
          if (tid < s) {
            const unsigned int xid1 = tid << 1;
            const unsigned int xid2 = (tid + s) << 1;
            cache_grad_attn_weight[tid] += cache_grad_attn_weight[tid + s];
            cache_grad_sampling_loc[xid1] += cache_grad_sampling_loc[xid2];
            cache_grad_sampling_loc[xid1 + 1] += cache_grad_sampling_loc[xid2 + 1];
          }
          __SYNCTHREADS_LM;
        }

        if (tid == 0) {
          *grad_sampling_loc_out       = cache_grad_sampling_loc[0];
          *(grad_sampling_loc_out + 1) = cache_grad_sampling_loc[1];
          *grad_attn_weight_out        = cache_grad_attn_weight[0];
        }
        __SYNCTHREADS_LM;

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += grad_weight_stride;
        grad_sampling_loc_out += grad_loc_stride;
      }
    }
  }
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_shm_reduce_v1(const int       n,
                                                              const scalar_t *grad_col,
                                                              const scalar_t *data_value,
                                                              const int64_t  *data_spatial_shapes,
                                                              const int64_t  *data_level_start_index,
                                                              const scalar_t *data_sampling_loc,
                                                              const scalar_t *data_attn_weight,
                                                              const int       batch_size,
                                                              const int       spatial_size,
                                                              const int       num_heads,
                                                              const int       channels,
                                                              const int       num_levels,
                                                              const int       num_query,
                                                              const int       num_point,
                                                              acc_t          *grad_value,
                                                              acc_t          *grad_sampling_loc,
                                                              acc_t          *grad_attn_weight) {
  MUSA_1D_KERNEL_LOOP(index, n) {
    extern __shared__ int _s[];
    acc_t                *cache_grad_sampling_loc = reinterpret_cast<acc_t *>(_s);
    acc_t                *cache_grad_attn_weight  = cache_grad_sampling_loc + 2 * blockDim.x;
    unsigned int          tid                     = threadIdx.x;
    int                   _temp                   = index;
    const int             c_col                   = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    const acc_t top_grad = static_cast<acc_t>(grad_col[index]);

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int grad_sampling_ptr          = data_weight_ptr;
    acc_t    *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t    *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const int grad_weight_stride         = 1;
    const int grad_loc_stride            = 2;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id   = data_level_start_index[l_col];
      const int       spatial_h_ptr    = l_col << 1;
      const int       spatial_h        = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w        = data_spatial_shapes[spatial_h_ptr + 1];
      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im                                      = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im                                      = loc_w * spatial_w - acc_t(0.5);
        *(cache_grad_sampling_loc + (threadIdx.x << 1))       = 0;
        *(cache_grad_sampling_loc + ((threadIdx.x << 1) + 1)) = 0;
        *(cache_grad_attn_weight + threadIdx.x)               = 0;
        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          ms_deform_attn_col2im_bilinear(data_value_ptr,
                                         spatial_h,
                                         spatial_w,
                                         num_heads,
                                         channels,
                                         h_im,
                                         w_im,
                                         m_col,
                                         c_col,
                                         top_grad,
                                         weight,
                                         grad_value_ptr,
                                         cache_grad_sampling_loc + (threadIdx.x << 1),
                                         cache_grad_attn_weight + threadIdx.x);
        }

        __SYNCTHREADS_LM;
        if (tid == 0) {
          acc_t _grad_w = cache_grad_sampling_loc[0], _grad_h = cache_grad_sampling_loc[1],
                _grad_a = cache_grad_attn_weight[0];
          int sid       = 2;
          for (unsigned int tid = 1; tid < blockDim.x; ++tid) {
            _grad_w += cache_grad_sampling_loc[sid];
            _grad_h += cache_grad_sampling_loc[sid + 1];
            _grad_a += cache_grad_attn_weight[tid];
            sid += 2;
          }

          *grad_sampling_loc_out       = _grad_w;
          *(grad_sampling_loc_out + 1) = _grad_h;
          *grad_attn_weight_out        = _grad_a;
        }
        __SYNCTHREADS_LM;

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += grad_weight_stride;
        grad_sampling_loc_out += grad_loc_stride;
      }
    }
  }
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_shm_reduce_v2(const int       n,
                                                              const scalar_t *grad_col,
                                                              const scalar_t *data_value,
                                                              const int64_t  *data_spatial_shapes,
                                                              const int64_t  *data_level_start_index,
                                                              const scalar_t *data_sampling_loc,
                                                              const scalar_t *data_attn_weight,
                                                              const int       batch_size,
                                                              const int       spatial_size,
                                                              const int       num_heads,
                                                              const int       channels,
                                                              const int       num_levels,
                                                              const int       num_query,
                                                              const int       num_point,
                                                              acc_t          *grad_value,
                                                              acc_t          *grad_sampling_loc,
                                                              acc_t          *grad_attn_weight) {
  MUSA_1D_KERNEL_LOOP(index, n) {
    extern __shared__ int _s[];
    acc_t                *cache_grad_sampling_loc = reinterpret_cast<acc_t *>(_s);
    acc_t                *cache_grad_attn_weight  = cache_grad_sampling_loc + 2 * blockDim.x;
    unsigned int          tid                     = threadIdx.x;
    int                   _temp                   = index;
    const int             c_col                   = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    const acc_t top_grad = static_cast<acc_t>(grad_col[index]);

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int grad_sampling_ptr          = data_weight_ptr;
    acc_t    *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t    *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const int grad_weight_stride         = 1;
    const int grad_loc_stride            = 2;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id   = data_level_start_index[l_col];
      const int       spatial_h_ptr    = l_col << 1;
      const int       spatial_h        = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w        = data_spatial_shapes[spatial_h_ptr + 1];
      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im                                      = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im                                      = loc_w * spatial_w - acc_t(0.5);
        *(cache_grad_sampling_loc + (threadIdx.x << 1))       = 0;
        *(cache_grad_sampling_loc + ((threadIdx.x << 1) + 1)) = 0;
        *(cache_grad_attn_weight + threadIdx.x)               = 0;
        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          ms_deform_attn_col2im_bilinear(data_value_ptr,
                                         spatial_h,
                                         spatial_w,
                                         num_heads,
                                         channels,
                                         h_im,
                                         w_im,
                                         m_col,
                                         c_col,
                                         top_grad,
                                         weight,
                                         grad_value_ptr,
                                         cache_grad_sampling_loc + (threadIdx.x << 1),
                                         cache_grad_attn_weight + threadIdx.x);
        }

        __SYNCTHREADS_LM;

        for (unsigned int s = blockDim.x / 2, spre = blockDim.x; s > 0; s >>= 1, spre >>= 1) {
          if (tid < s) {
            const unsigned int xid1 = tid << 1;
            const unsigned int xid2 = (tid + s) << 1;
            cache_grad_attn_weight[tid] += cache_grad_attn_weight[tid + s];
            cache_grad_sampling_loc[xid1] += cache_grad_sampling_loc[xid2];
            cache_grad_sampling_loc[xid1 + 1] += cache_grad_sampling_loc[xid2 + 1];
            if (tid + (s << 1) < spre) {
              cache_grad_attn_weight[tid] += cache_grad_attn_weight[tid + (s << 1)];
              cache_grad_sampling_loc[xid1] += cache_grad_sampling_loc[xid2 + (s << 1)];
              cache_grad_sampling_loc[xid1 + 1] += cache_grad_sampling_loc[xid2 + 1 + (s << 1)];
            }
          }
          __SYNCTHREADS_LM;
        }

        if (tid == 0) {
          *grad_sampling_loc_out       = cache_grad_sampling_loc[0];
          *(grad_sampling_loc_out + 1) = cache_grad_sampling_loc[1];
          *grad_attn_weight_out        = cache_grad_attn_weight[0];
        }
        __SYNCTHREADS_LM;

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += grad_weight_stride;
        grad_sampling_loc_out += grad_loc_stride;
      }
    }
  }
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_shm_reduce_v2_multi_blocks(const int       n,
                                                                           const scalar_t *grad_col,
                                                                           const scalar_t *data_value,
                                                                           const int64_t  *data_spatial_shapes,
                                                                           const int64_t  *data_level_start_index,
                                                                           const scalar_t *data_sampling_loc,
                                                                           const scalar_t *data_attn_weight,
                                                                           const int       batch_size,
                                                                           const int       spatial_size,
                                                                           const int       num_heads,
                                                                           const int       channels,
                                                                           const int       num_levels,
                                                                           const int       num_query,
                                                                           const int       num_point,
                                                                           acc_t          *grad_value,
                                                                           acc_t          *grad_sampling_loc,
                                                                           acc_t          *grad_attn_weight) {
  MUSA_1D_KERNEL_LOOP(index, n) {
    extern __shared__ int _s[];
    acc_t                *cache_grad_sampling_loc = reinterpret_cast<acc_t *>(_s);
    acc_t                *cache_grad_attn_weight  = cache_grad_sampling_loc + 2 * blockDim.x;
    unsigned int          tid                     = threadIdx.x;
    int                   _temp                   = index;
    const int             c_col                   = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    const acc_t top_grad = static_cast<acc_t>(grad_col[index]);

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int grad_sampling_ptr          = data_weight_ptr;
    acc_t    *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t    *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const int grad_weight_stride         = 1;
    const int grad_loc_stride            = 2;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id   = data_level_start_index[l_col];
      const int       spatial_h_ptr    = l_col << 1;
      const int       spatial_h        = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w        = data_spatial_shapes[spatial_h_ptr + 1];
      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im                                      = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im                                      = loc_w * spatial_w - acc_t(0.5);
        *(cache_grad_sampling_loc + (threadIdx.x << 1))       = 0;
        *(cache_grad_sampling_loc + ((threadIdx.x << 1) + 1)) = 0;
        *(cache_grad_attn_weight + threadIdx.x)               = 0;
        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          ms_deform_attn_col2im_bilinear(data_value_ptr,
                                         spatial_h,
                                         spatial_w,
                                         num_heads,
                                         channels,
                                         h_im,
                                         w_im,
                                         m_col,
                                         c_col,
                                         top_grad,
                                         weight,
                                         grad_value_ptr,
                                         cache_grad_sampling_loc + (threadIdx.x << 1),
                                         cache_grad_attn_weight + threadIdx.x);
        }

        __SYNCTHREADS_LM;

        for (unsigned int s = blockDim.x / 2, spre = blockDim.x; s > 0; s >>= 1, spre >>= 1) {
          if (tid < s) {
            const unsigned int xid1 = tid << 1;
            const unsigned int xid2 = (tid + s) << 1;
            cache_grad_attn_weight[tid] += cache_grad_attn_weight[tid + s];
            cache_grad_sampling_loc[xid1] += cache_grad_sampling_loc[xid2];
            cache_grad_sampling_loc[xid1 + 1] += cache_grad_sampling_loc[xid2 + 1];
            if (tid + (s << 1) < spre) {
              cache_grad_attn_weight[tid] += cache_grad_attn_weight[tid + (s << 1)];
              cache_grad_sampling_loc[xid1] += cache_grad_sampling_loc[xid2 + (s << 1)];
              cache_grad_sampling_loc[xid1 + 1] += cache_grad_sampling_loc[xid2 + 1 + (s << 1)];
            }
          }
          __SYNCTHREADS_LM;
        }

        if (tid == 0) {
          atomicAdd(grad_sampling_loc_out, cache_grad_sampling_loc[0]);
          atomicAdd(grad_sampling_loc_out + 1, cache_grad_sampling_loc[1]);
          atomicAdd(grad_attn_weight_out, cache_grad_attn_weight[0]);
        }
        __SYNCTHREADS_LM;

        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += grad_weight_stride;
        grad_sampling_loc_out += grad_loc_stride;
      }
    }
  }
}

template <typename scalar_t, typename acc_t = ms_deform_attn_acc_t>
__global__ void ms_deformable_col2im_gpu_kernel_gm(const int       n,
                                                   const scalar_t *grad_col,
                                                   const scalar_t *data_value,
                                                   const int64_t  *data_spatial_shapes,
                                                   const int64_t  *data_level_start_index,
                                                   const scalar_t *data_sampling_loc,
                                                   const scalar_t *data_attn_weight,
                                                   const int       batch_size,
                                                   const int       spatial_size,
                                                   const int       num_heads,
                                                   const int       channels,
                                                   const int       num_levels,
                                                   const int       num_query,
                                                   const int       num_point,
                                                   acc_t          *grad_value,
                                                   acc_t          *grad_sampling_loc,
                                                   acc_t          *grad_attn_weight) {
  MUSA_1D_KERNEL_LOOP(index, n) {
    int       _temp = index;
    const int c_col = _temp % channels;
    _temp /= channels;
    const int sampling_index = _temp;
    const int m_col          = _temp % num_heads;
    _temp /= num_heads;
    _temp /= num_query;
    const int b_col = _temp;

    const acc_t top_grad = static_cast<acc_t>(grad_col[index]);

    int       data_weight_ptr            = sampling_index * num_levels * num_point;
    int       data_loc_w_ptr             = data_weight_ptr << 1;
    const int grad_sampling_ptr          = data_weight_ptr;
    acc_t    *grad_sampling_loc_out      = grad_sampling_loc + (grad_sampling_ptr << 1);
    acc_t    *grad_attn_weight_out       = grad_attn_weight + grad_sampling_ptr;
    const int grad_weight_stride         = 1;
    const int grad_loc_stride            = 2;
    const int qid_stride                 = num_heads * channels;
    const int data_value_ptr_init_offset = b_col * spatial_size * qid_stride;

    for (int l_col = 0; l_col < num_levels; ++l_col) {
      const int       level_start_id   = data_level_start_index[l_col];
      const int       spatial_h_ptr    = l_col << 1;
      const int       spatial_h        = data_spatial_shapes[spatial_h_ptr];
      const int       spatial_w        = data_spatial_shapes[spatial_h_ptr + 1];
      const int       value_ptr_offset = data_value_ptr_init_offset + level_start_id * qid_stride;
      const scalar_t *data_value_ptr   = data_value + value_ptr_offset;
      acc_t          *grad_value_ptr   = grad_value + value_ptr_offset;

      for (int p_col = 0; p_col < num_point; ++p_col) {
        const acc_t loc_w  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr]);
        const acc_t loc_h  = static_cast<acc_t>(data_sampling_loc[data_loc_w_ptr + 1]);
        const acc_t weight = static_cast<acc_t>(data_attn_weight[data_weight_ptr]);

        const acc_t h_im = loc_h * spatial_h - acc_t(0.5);
        const acc_t w_im = loc_w * spatial_w - acc_t(0.5);
        if (h_im > -1 && w_im > -1 && h_im < spatial_h && w_im < spatial_w) {
          ms_deform_attn_col2im_bilinear_gm(data_value_ptr,
                                            spatial_h,
                                            spatial_w,
                                            num_heads,
                                            channels,
                                            h_im,
                                            w_im,
                                            m_col,
                                            c_col,
                                            top_grad,
                                            weight,
                                            grad_value_ptr,
                                            grad_sampling_loc_out,
                                            grad_attn_weight_out);
        }
        data_weight_ptr += 1;
        data_loc_w_ptr += 2;
        grad_attn_weight_out += grad_weight_stride;
        grad_sampling_loc_out += grad_loc_stride;
      }
    }
  }
}
#endif  // DEFORM_ATTN_MUSA_KERNEL
