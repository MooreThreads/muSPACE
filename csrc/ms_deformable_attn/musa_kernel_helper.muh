#ifndef MUSPACE_MUSA_KERNEL_HELPER_MUH_
#define MUSPACE_MUSA_KERNEL_HELPER_MUH_

#include <musa.h>
#include <musa_bf16.h>
#include <musa_fp16.h>

#define MUSPACE_MUSA_1D_KERNEL_LOOP(i, n) \
  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < (n); i += blockDim.x * gridDim.x)

#define MUSA_1D_KERNEL_LOOP MUSPACE_MUSA_1D_KERNEL_LOOP

using phalf  = half;
using bf16_t = __mt_bfloat16;

// MSDA evaluates sampling geometry, bilinear weights and the weighted sum in
// this type.  bfloat16 only stores the data; every arithmetic step that decides
// *where* a value is sampled and *how* the four corners are combined runs in
// fp32.  Kernels and the FFI launchers take it as a defaulted second template
// parameter, so the fp32 instantiation resolves it back to float.
using ms_deform_attn_acc_t = float;

#define __PHALF(x) (x)

#if defined(__MUSA_ARCH__) && __MUSA_ARCH__ >= 310
#define __SYNCTHREADS_LM __syncthreads_lm()
#else
#define __SYNCTHREADS_LM __syncthreads()
#endif

#endif  // MUSPACE_MUSA_KERNEL_HELPER_MUH_
