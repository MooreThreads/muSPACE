@@ -0,0 +1,30 @@
+"""Torch-only image helpers used when torchvision is unavailable."""
+
+import math
+
+import torch
+import torch.nn.functional as F
+
+
+def rotate(image, angle, center=None):
+    """Rotate a CHW tensor with torchvision's default nearest interpolation."""
+    if image.ndim != 3:
+        raise ValueError(f"expected a CHW tensor, got shape {tuple(image.shape)}")
+    _, height, width = image.shape
+    if center is None:
+        center = ((width - 1) * 0.5, (height - 1) * 0.5)
+    center_x = (2.0 * float(center[0]) + 1.0 - width) / width
+    center_y = (2.0 * float(center[1]) + 1.0 - height) / height
+    radians = math.radians(float(angle))
+    cosine = math.cos(radians)
+    sine = math.sin(radians)
+    translate_x = center_x - cosine * center_x + sine * center_y
+    translate_y = center_y - sine * center_x - cosine * center_y
+    theta = image.new_tensor(
+        [[cosine, -sine, translate_x], [sine, cosine, translate_y]]
+    ).unsqueeze(0)
+    batch = image.unsqueeze(0)
+    grid = F.affine_grid(theta, batch.shape, align_corners=False)
+    return F.grid_sample(
+        batch, grid, mode="nearest", padding_mode="zeros", align_corners=False
+    ).squeeze(0)

