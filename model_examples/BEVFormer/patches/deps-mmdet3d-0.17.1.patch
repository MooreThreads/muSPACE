@@ -0,0 +1,12 @@
+def missing_op(name):
+
+    def unavailable(*args, **kwargs):
+        raise RuntimeError(
+            f'mmdet3d native op {name} is unavailable in the '
+            'muSPACE compatibility build')
+
+    return unavailable
+
+
+def __getattr__(name):
+    return missing_op(name)
