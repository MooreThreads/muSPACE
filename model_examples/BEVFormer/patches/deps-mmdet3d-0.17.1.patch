diff --git a/mmdet3d/ops/voxel/voxel_layer.py b/mmdet3d/ops/voxel/voxel_layer.py
new file mode 100644
--- /dev/null
+++ b/mmdet3d/ops/voxel/voxel_layer.py
@@ -0,0 +1,23 @@
+"""muSPACE MUSA implementation of the mmdet3d voxel layer ABI."""
+
+import torch
+from mu_space.ops.hard_voxelize import dynamic_voxelize as _dynamic
+from mu_space.ops.hard_voxelize import hard_voxelize as _hard
+
+
+def dynamic_voxelize(points, voxel_size, coors_range, coors, NDim=3):
+    result = _dynamic(points, voxel_size, coors_range, ndim=NDim)
+    coors.copy_(result)
+    return coors
+
+
+def hard_voxelize(points, voxels, coors, num_points_per_voxel,
+                  voxel_size, coors_range, max_points, max_voxels,
+                  NDim=3, deterministic=True):
+    result = _hard(points, voxel_size, coors_range, max_points, max_voxels,
+                   ndim=NDim, deterministic=deterministic)
+    count = result[0].shape[0]
+    voxels[:count].copy_(result[0])
+    coors[:count].copy_(result[1])
+    num_points_per_voxel[:count].copy_(result[2])
+    return count
