diff --git a/wan_va/utils/device.py b/wan_va/utils/device.py
new file mode 100644
index 0000000..354f15c
--- /dev/null
+++ b/wan_va/utils/device.py
@@ -0,0 +1,146 @@
+# Copyright 2024-2025 The Robbyant Team Authors. All rights reserved.
+"""Device helpers for CUDA and Moore Threads MUSA backends."""
+from __future__ import annotations
+
+import os
+import sys
+from typing import Optional
+
+import torch
+
+_DEVICE_TYPE: Optional[str] = None
+
+
+def _ensure_torch_musa() -> None:
+    if not hasattr(torch, "musa"):
+        try:
+            import torch_musa  # noqa: F401
+        except ImportError:
+            pass
+
+
+def is_torchada_active() -> bool:
+    return "torchada" in sys.modules
+
+
+def use_cuda_api() -> bool:
+    """Use torch.cuda.* device strings/APIs (including torchada on MUSA)."""
+    return is_cuda() or (is_musa() and is_torchada_active())
+
+
+def get_device_type() -> str:
+    """Return ``cuda``, ``musa``, or ``cpu``."""
+    global _DEVICE_TYPE
+    if _DEVICE_TYPE is not None:
+        return _DEVICE_TYPE
+
+    forced = os.environ.get("LINGBOT_DEVICE", "auto").lower()
+    if forced in {"cuda", "musa", "cpu"}:
+        _DEVICE_TYPE = forced
+        return _DEVICE_TYPE
+
+    _ensure_torch_musa()
+    if hasattr(torch, "musa") and torch.musa.is_available():
+        _DEVICE_TYPE = "musa"
+    elif torch.cuda.is_available():
+        _DEVICE_TYPE = "cuda"
+    else:
+        _DEVICE_TYPE = "cpu"
+    return _DEVICE_TYPE
+
+
+def is_musa() -> bool:
+    return get_device_type() == "musa"
+
+
+def is_cuda() -> bool:
+    return get_device_type() == "cuda"
+
+
+def is_accelerator_available() -> bool:
+    return get_device_type() in {"cuda", "musa"}
+
+
+def get_device_count() -> int:
+    if use_cuda_api():
+        return torch.cuda.device_count()
+    if is_musa():
+        return torch.musa.device_count()
+    if is_cuda():
+        return torch.cuda.device_count()
+    return 0
+
+
+def get_torch_device(rank: int = 0) -> torch.device:
+    if use_cuda_api():
+        return torch.device(f"cuda:{rank}")
+    if is_musa():
+        return torch.device(f"musa:{rank}")
+    if is_cuda():
+        return torch.device(f"cuda:{rank}")
+    return torch.device("cpu")
+
+
+def get_device_name(rank: int = 0) -> str:
+    if is_musa():
+        return torch.musa.get_device_name(rank)
+    if use_cuda_api() or is_cuda():
+        try:
+            return torch.cuda.get_device_name(rank)
+        except Exception:
+            return torch.musa.get_device_name(rank)
+    return "cpu"
+
+
+def set_device(rank: int) -> None:
+    if use_cuda_api() or is_cuda():
+        torch.cuda.set_device(rank)
+    elif is_musa():
+        torch.musa.set_device(rank)
+
+
+def empty_cache() -> None:
+    if use_cuda_api() or is_cuda():
+        torch.cuda.empty_cache()
+    elif is_musa():
+        torch.musa.empty_cache()
+
+
+def synchronize() -> None:
+    if use_cuda_api() or is_cuda():
+        torch.cuda.synchronize()
+    elif is_musa():
+        torch.musa.synchronize()
+
+
+def is_on_accelerator(obj: torch.Tensor) -> bool:
+    if not torch.is_tensor(obj):
+        return False
+    return obj.device.type in {"cuda", "musa"}
+
+
+def get_dist_backend() -> str:
+    override = os.environ.get("LINGBOT_DIST_BACKEND")
+    if override:
+        return override
+    if use_cuda_api():
+        return "nccl"
+    if is_musa():
+        return "mccl"
+    if is_cuda():
+        return "nccl"
+    return "gloo"
+
+
+def default_attn_mode(preferred: str = "torch") -> str:
+    if is_musa() and not is_torchada_active() and preferred in {"flex", "flashattn"}:
+        return "torch"
+    return preferred
+
+
+def supports_flex_attention() -> bool:
+    if os.environ.get("LINGBOT_DISABLE_FLEX", "0") == "1":
+        return False
+    if is_musa() and not is_torchada_active():
+        return False
+    return True
diff --git a/wan_va/utils/musa_bootstrap.py b/wan_va/utils/musa_bootstrap.py
new file mode 100644
index 0000000..d93882f
--- /dev/null
+++ b/wan_va/utils/musa_bootstrap.py
@@ -0,0 +1,79 @@
+# Copyright 2024-2025 The Robbyant Team Authors. All rights reserved.
+"""Bootstrap torchada and MUSA-specific patches before model imports."""
+from __future__ import annotations
+
+import os
+import sys
+import warnings
+
+_TORCHADA_TRIED = False
+
+
+def _should_use_torchada() -> bool:
+    if os.environ.get("LINGBOT_DISABLE_TORCHADA", "0") == "1":
+        return False
+    forced = os.environ.get("LINGBOT_DEVICE", "auto").lower()
+    if forced in {"cuda", "cpu"}:
+        return False
+    if forced == "musa":
+        return True
+    try:
+        import torch
+
+        return hasattr(torch, "musa") and torch.musa.is_available()
+    except ImportError:
+        return False
+
+
+def bootstrap_torchada() -> bool:
+    """Load torchada so CUDA APIs and flex_attention work on MUSA."""
+    global _TORCHADA_TRIED
+    if _TORCHADA_TRIED:
+        return "torchada" in sys.modules
+    _TORCHADA_TRIED = True
+
+    if not _should_use_torchada():
+        return False
+
+    try:
+        import torchada  # noqa: F401
+        return True
+    except ImportError:
+        warnings.warn(
+            "MUSA platform detected but torchada is not installed; "
+            "flex attention will fall back to torch SDPA.",
+            stacklevel=2,
+        )
+        return False
+
+
+def patch_diffusers_for_musa() -> None:
+    import diffusers.utils.import_utils as import_utils
+
+    import_utils._flash_attn_available = False
+    import_utils._flash_attn_3_available = False
+
+
+def patch_flash_attn_for_musa() -> None:
+    try:
+        import flash_attn
+        import flash_attn.flash_attn_interface as interface
+    except ImportError:
+        return
+
+    if not hasattr(flash_attn, "flash_attn_func") and hasattr(interface, "flash_attn_func"):
+        flash_attn.flash_attn_func = interface.flash_attn_func
+    if not hasattr(flash_attn, "flash_attn_varlen_func") and hasattr(
+        interface, "flash_attn_varlen_func"
+    ):
+        flash_attn.flash_attn_varlen_func = interface.flash_attn_varlen_func
+
+
+def bootstrap_musa() -> None:
+    bootstrap_torchada()
+    from .device import is_musa
+
+    if not is_musa():
+        return
+    patch_flash_attn_for_musa()
+    patch_diffusers_for_musa()
