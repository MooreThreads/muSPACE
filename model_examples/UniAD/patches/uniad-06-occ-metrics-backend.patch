+def stat_scores_multiple_classes(prediction, target, num_classes):
+    prediction = prediction.reshape(-1).long()
+    target = target.reshape(-1).long()
+    valid = (target >= 0) & (target < num_classes)
+    prediction = prediction[valid]
+    target = target[valid]
+    matrix = torch.bincount(
+        target * num_classes + prediction,
+        minlength=num_classes * num_classes,
+    ).reshape(num_classes, num_classes)
+    true_positive = matrix.diag()
+    support = matrix.sum(dim=1)
+    false_positive = matrix.sum(dim=0) - true_positive
+    false_negative = support - true_positive
+    true_negative = matrix.sum() - true_positive - false_positive - false_negative
+    return true_positive, false_positive, true_negative, false_negative, support
