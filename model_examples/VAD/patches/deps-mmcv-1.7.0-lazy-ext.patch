+"""Placeholder extension loader for a pure-Python mmcv install.
+
+This environment carries the Python-only ``mmcv==1.7.0`` distribution, which
+ships no compiled ``mmcv/_ext`` module. Importing ``mmcv.ops`` would abort on
+the first ``ext_loader.load_ext`` call, so this loader returns a placeholder
+object instead: every attribute is a callable that raises a clear error, which
+keeps imports working and makes any real operator use fail explicitly rather
+than silently.
+"""
+
+
+class _UnavailableExtension:
+    def __init__(self, name):
+        self._name = name
+
+    def __repr__(self):
+        return f"<unavailable mmcv extension {self._name!r}>"
+
+    def __getattr__(self, attr):
+        def _unavailable(*args, **kwargs):
+            raise RuntimeError(
+                f"mmcv.{self._name}.{attr} is unavailable: this environment has the "
+                "Python-only mmcv package, which ships no compiled extension module "
+                "(mmcv-full). Install mmcv-full to call this operator.")
+
+        _unavailable.__name__ = attr
+        return _unavailable
+
+
+def load_ext(name, funcs):
+    return _UnavailableExtension(name)
+
+
+def check_ops_exist():
+    """This environment ships no compiled mmcv ops."""
+    return False
